# Copy this file to .env.local before running the project.
# Generate a password hash with: node scripts/generate-admin-hash.mjs "your-password"
# Generate the encryption key with: node scripts/generate-encryption-key.mjs
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@lighthouselaw.vn
ADMIN_PASSWORD_HASH=scrypt:replace-salt:replace-derived-key
DATA_ENCRYPTION_KEY=base64-encoded-32-byte-key
